{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
    // "ApiKey" is set via environment variable / secret store, not here.
  },
  "ConnectionStrings": {
    "StatementPortal": "Server=.;Database=StatementPortal;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Sso": {
    "AuthorizeEndpoint": "https://sso.lotusbank.internal/connect/authorize",
    "TokenEndpoint": "https://sso.lotusbank.internal/connect/token",
    "PermissionsEndpoint": "https://sso.lotusbank.internal/api/permissions",
    "JwksUri": "https://sso.lotusbank.internal/.well-known/jwks.json",
    "Issuer": "https://sso.lotusbank.internal",
    "Audience": "statement-portal",
    "ClientId": "statement-portal"
    // "ClientSecret" is set via environment variable / secret store, not here.
  },
  "StatementService": {
    "BaseUrl": "https://statement-service.lotusbank.internal/",
    "AuthPath": "api/auth/login",
    "TimeoutSeconds": 30
    // "Username" and "Password" (the service-account credentials) are set via
    // environment variable / secret store, not here.
  },
  "AllowedOrigins": [
    "https://statements.lotusbank.internal"
  ],
  "KnownProxies": [
    "10.0.0.4"
  ]
}
